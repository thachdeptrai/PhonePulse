<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="4dp"
                android:color="#22000000" /> <!-- Subtle shadow effect -->
            <corners android:radius="12dp" /> <!-- Rounded corners for square -->
        </shape>
    </item>
    <!-- Main Square with Gradient -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/colorSurface"
                android:endColor="?attr/color"
                android:angle="45"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary" />
            <corners android:radius="12dp" /> <!-- Matching rounded corners -->
        </shape>
    </item>
</layer-list>